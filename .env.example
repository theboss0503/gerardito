# Copia este archivo como .env y rellena tu API key:
#   cp .env.example .env

OLLAMA_HOST=https://ollama.com
MODEL_NAME=gemma4:31b
OLLAMA_API_KEY=tu_api_key_de_ollama_aqui

DB_PASSWORD=cambia_esto_en_produccion
DATABASE_URL=postgresql+asyncpg://gerardito:${DB_PASSWORD}@localhost:5432/gerardito_db
PORT=8000
ENVIRONMENT=development

# Proxy del Vite dev server (no necesita definirse en .env)
# En local: default http://127.0.0.1:8000
# En Docker (VM): se define en docker-compose.yml como http://api:8000
